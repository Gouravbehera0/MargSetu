[Unit]
Description=MargSetu FastAPI Optimization Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/MargSetu
ExecStart=/home/ubuntu/MargSetu/venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/ubuntu/MargSetu

[Install]
WantedBy=multi-user.target
